# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

# Production default: one OpenRouter key covers chat, embeddings, speech, and images.
# Paste it here or on first-run signup / Admin → Connections. Extra OpenAI-compatible
# providers can still be added under Connections → Advanced.
OPENROUTER_API_KEY=''
# OPENROUTER_API_BASE_URL='https://openrouter.ai/api/v1'

# ── Default Model ────────────────────────────────────────────────────────────
# The model selected by default for new chats. Defaults to Venice: Uncensored
# (venice-uncensored) — an uncensored instruct-tuned LLM by dphn.ai / Venice.ai,
# fine-tuned from Mistral-Small-24B-Instruct-2501. 33K context, $0.20/M input,
# $0.90/M output via OpenRouter.
# Set to empty string to disable, or comma-separate for multiple defaults.
# DEFAULT_MODELS='venice-uncensored'
#
# Models pinned at the top of the model selector.
# DEFAULT_PINNED_MODELS='venice-uncensored'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Optional extra OpenAI-compatible providers; semicolon-separate to register several
# connections at once (order must match between the two lists).
# OPENAI_API_BASE_URLS='https://openrouter.ai/api/v1;https://router.huggingface.co/v1;https://<your-runpod-endpoint>/v1'
# OPENAI_API_KEYS='sk-or-...;hf_...;<runpod-key>'

# ── Data Persistence (Railway / Docker / Ephemeral Deployments) ──────────────
# Railway: Attach a Volume at /app/backend/data in the dashboard (Settings → Volumes).
# Without a volume, ALL data is lost on every deploy/rebuild. The app will warn
# at startup if it detects an unmounted data directory.
#
# DATA_DIR — override the data directory location (default: /app/backend/data in Docker)
# DATA_DIR='/app/backend/data'
#
# FORCE_ENV_CONFIG — force-sync critical API keys from environment variables into
# the database on EVERY startup. Auto-enabled on Railway. Enable this if running
# without a persistent volume so API keys survive database wipes.
# Synced keys: OPENROUTER_API_KEY, OPENROUTER_API_BASE_URL, OPENAI_API_KEY,
# OPENAI_API_BASE_URL, GEMINI_API_KEY, AUDIO_TTS_OPENAI_API_KEY, AUDIO_STT_OPENAI_API_KEY
# FORCE_ENV_CONFIG='true'
#
# API keys are also backed up to DATA_DIR/api_keys_backup.json on startup and
# restored automatically if the database is wiped but the volume survived.

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='qwythos'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
