# Copy to `.env` in this directory (rust-backend/) and adjust as needed.
# Variable names match src/config.rs's AppConfig::from_env().

HOST=0.0.0.0
PORT=8080

# Points at the SAME SQLite database the existing Python/FastAPI backend
# uses, so user accounts and sessions are shared during the migration.
DATABASE_URL=sqlite://../backend/data/webui.db

# If unset, falls back to WEBUI_JWT_SECRET_KEY, then to the contents of
# ../backend/.webui_secret_key (same resolution order as start_windows.bat),
# so tokens minted here are accepted by the existing FastAPI service too.
# WEBUI_SECRET_KEY=
JWT_EXPIRY_HOURS=72

# Comma-separated OpenAI-compatible API base URLs + matching API keys
# (same order, use "" for keyless entries). Used by the Phase 1 chat/model
# proxy — not required for the Phase 0 auth slice.
# OPENAI_API_BASE_URLS=https://api.openai.com/v1
# OPENAI_API_KEYS=sk-...
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Comma-separated list of allowed origins for the Streamlit app, or "*".
CORS_ALLOW_ORIGIN=*

# LLM Council feature (see qwythos/utils/council.py)
ENABLE_COUNCIL=true
# COUNCIL_MODELS=
# COUNCIL_CHAIRMAN_MODEL=
